{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(python -m http.server *)",
      "Bash(php -S localhost:*)",
      "Bash(php -l *)"
    ],
    "ask": [
      "Bash(git push*)",
      "PowerShell(git push*)"
    ],
    "deny": [
      "Read(./mail-config.php)",
      "Edit(./mail-config.php)"
    ]
  }
}
