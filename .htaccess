DirectoryIndex index.html
ErrorDocument 404 /404.html

# Mailbox credentials for contact.php
<Files "mail-config*.php">
  Require all denied
</Files>

<IfModule mod_rewrite.c>
RewriteEngine On

# One canonical host: https://britishinternationalcollege.co.za
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://britishinternationalcollege.co.za%{REQUEST_URI} [R=301,L]

# /index.html -> / (only on direct requests, not the DirectoryIndex lookup)
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^index\.html$ / [R=301,L]

# Old WordPress pages that no longer exist or were renamed
RewriteRule ^(calendar|calendar-2|calendar-pta|2025-2)/?$ /calendar-2027.html [R=301,L]
RewriteRule ^stuart/?$ / [R=301,L]
RewriteRule ^sibjects-offered-pta(/|\.html)?$ /subjects-offered-pta.html [R=301,L]
RewriteRule ^elementor-1087(/|\.html)?$ /admissions-worldwide.html [R=301,L]

# Old WordPress URLs: /about-us/ -> /about-us.html
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9-]+)/?$ /$1.html [R=301,L]
</IfModule>
